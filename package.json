{
  "name": "lightning-jukebox",
  "version": "0.1.0",
  "description": "Lightning Network Jukebox",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.mts",
    "preview:web": "vite preview --config vite.web.config.mts",
    "typecheck": "tsc --build",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.5.2",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.lacrypta.lightning-jukebox",
    "productName": "Lightning Jukebox",
    "directories": {
      "buildResources": "resources"
    },
    "files": ["out/**"],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
